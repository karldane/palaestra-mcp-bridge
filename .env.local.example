# Copy this file to .env.local and fill in real values before running
# docker compose --env-file .env.local up
#
# These correspond to secrets held in AWS Secrets Manager at:
#   /staging6/eks/mcp-bridge/app/   → encryption-key
#   /staging6/eks/mcp-bridge/qdrant/ → api-key, read-only-key

# 32-byte base64-encoded encryption key for the bridge DB
# Generate one locally with: openssl rand -base64 32
ENCRYPTION_KEY=replace-me-with-a-32-byte-base64-key

# Qdrant API keys (any non-empty strings work for local testing)
QDRANT_API_KEY=local-admin-key
QDRANT_READ_ONLY_KEY=local-read-only-key

# Override the ISSUER if you want OAuth flows to work end-to-end
# (for healthz/readyz smoke tests the default localhost:8080 is fine)
# ISSUER=http://localhost:8080
